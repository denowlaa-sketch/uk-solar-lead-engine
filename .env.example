DATABASE_URL="file:./dev.db"

# Free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=""

# Optional. If set, website/phone lookup uses Google Places instead of OSM Nominatim.
# https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=""

# Meta Lead Ads (Instant Forms). Webhook: GET/POST /api/facebook/leadgen
# Public HTTPS base (ngrok) can be FACEBOOK_PUBLIC_BASE_URL or TWILIO_PUBLIC_BASE_URL
FACEBOOK_VERIFY_TOKEN="change-me"
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_APP_SECRET=""
FACEBOOK_FORM_ID=""
FACEBOOK_ALLOW_SIMULATE="true"
FACEBOOK_PUBLIC_BASE_URL=""

# Email you (not the customer) when a lead is QUALIFIED
# Free Resend key: https://resend.com — test sends use onboarding@resend.dev to your account email
# OWNER_NOTIFY_EMAIL="you@example.com"
OWNER_NOTIFY_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM="UK Solar Lead Engine <onboarding@resend.dev>"

# Twilio live calls — only with stored consent. Keep LIVE false until you are ready to ring a real phone.
# Trial accounts only call numbers you verify in Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_PUBLIC_BASE_URL=""
TWILIO_LIVE_DIALS="false"
# WhatsApp voice (international). Register a WhatsApp sender in Twilio, then:
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID=""
TWILIO_CALL_CHANNEL="auto"

# Optional. If set, the live call uses GPT to understand everyday answers
# (e.g. "I need it done in about 3 months") and score confidence.
OPENAI_API_KEY=""
